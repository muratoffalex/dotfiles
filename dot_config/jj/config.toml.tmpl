[ui]
editor = '{{ .editor }}'
diff-editor = ["nvim", "-c", "DiffEditor $left $right $output"]
merge-editor = [
  "nvim",
  "-c", "let g:jj_diffconflicts_marker_length=$marker_length"
  "-c", "JJDiffConflicts!", "$output", "$base", "$left", "$right",
]
default-command = 'log'
pager = ["less", "-FRX"]

[merge-tools.diffconflicts]
program = "nvim"
merge-args = [
    "-c", "let g:jj_diffconflicts_marker_length=$marker_length",
    "-c", "JJDiffConflicts!", "$output", "$base", "$left", "$right",
]
merge-tool-edits-conflict-markers = true

[remotes.origin]
auto-track-bookmarks = '*'

[user]
name = "{{ .name }}"
email = "{{ .email }}"

[signing]
behavior = "own"
backend = "ssh"
key = "{{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub"

[snapshot]
auto-update-stale = true

[aliases]
cl = ['git', 'push', '-c', '@-']
sync = ['git', 'fetch', '--all-remotes']
evolve = ['rebase', '--skip-empty', '-d', 'main']
setmain = ["bookmark", "set", "main", "-r", "@-"]

[revset-aliases]
# ref: https://v5.chriskrycho.com/notes/jj-tip-rebase-all-branches-matching-a-revset/
wip = 'description(regex:"^(wip|WIP):?")'
